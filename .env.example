# Tony The Witch — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Required ────────────────────────────────────────────────────────

# PostgreSQL connection string (used by server and Drizzle migrations)
DATABASE_URL=postgresql://user:password@localhost:5432/tony_the_witch

# Secret used to sign session cookies (generate a random 64+ char string)
SESSION_SECRET=generate-a-random-64-char-string

# ─── Cloudinary (required for image uploads) ─────────────────────────

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Resend (required for order/notification emails) ─────────────────

RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── Email ───────────────────────────────────────────────────────────

# Address that receives admin notifications (e.g. new orders)
ADMIN_EMAIL=admin@example.com

# "From" address on outgoing emails
FROM_EMAIL=Tony The Witch <noreply@yourdomain.com>

# ─── Optional ────────────────────────────────────────────────────────

# Node environment (development | production)
# NODE_ENV=development

# Server port (defaults to 5000)
# PORT=5000

# Public URL of the app (used in email templates for links/images)
# APP_URL=https://yourdomain.com

# Set automatically by Vercel — no need to configure manually
# VERCEL_URL=
# VERCEL=
